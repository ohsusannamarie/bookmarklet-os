javascript:(async()=>{const sleep=ms=>new Promise(r=>setTimeout(r,ms));const dialog=[...document.querySelectorAll('[role="dialog"],.artdeco-modal')].find(el=>el.innerText.includes('Affiliated pages'));if(!dialog){alert('Open the "Affiliated pages" window first.');return;}const clicked=new WeakSet();let total=0,noNew=0;while(noNew<4){const buttons=[...dialog.querySelectorAll('button')].filter(b=>b.innerText.trim()==='Follow'&&!clicked.has(b)&&b.offsetParent!==null);if(buttons.length){noNew=0;for(const b of buttons){clicked.add(b);b.scrollIntoView({block:'center'});await sleep(350);b.click();total++;await sleep(900+Math.random()*700);}}else{noNew++;}const scrollable=[...dialog.querySelectorAll('*')].filter(e=>e.scrollHeight>e.clientHeight+50).sort((a,b)=>b.scrollHeight-a.scrollHeight)[0];if(scrollable){scrollable.scrollTop=scrollable.scrollHeight;}else{dialog.scrollTop=dialog.scrollHeight;}await sleep(1200);}alert(`Done. Clicked Follow on ${total} affiliated page${total===1?%27%27:%27s%27}.`);})();
